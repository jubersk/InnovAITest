					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"GET Models - Verify Created Model Exists\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"    const models = pm.response.json(); // Fixed reference to pm.response\r",
									"    const createdModel = models.find(model => model.id === pm.environment.get(\"createdModelId\"));\r",
									"\r",
									"    if (createdModel) {\r",
									"        pm.expect(createdModel.name, \"Model name should match\").to.eql(pm.environment.get(\"createdModelName\"));\r",
									"        pm.expect(createdModel.owner, \"Model owner should match\").to.eql(pm.environment.get(\"createdModelOwner\"));\r",
									"    }\r",
									"});\r",
									"\r",
									"// Tests tab in GET request\r",
									"pm.test(\"Get Models - Save ID for Deletion\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"\r",
									"    // Check if there are models available\r",
									"    pm.expect(jsonData).to.be.an('array').that.is.not.empty;\r",
									"\r",
									"    // Save the ID of the first model (or use any logic you need)\r",
									"    if (jsonData.length > 0) {\r",
									"        pm.environment.set(\"validModelId\", jsonData[0].id);\r",
									"    } else {\r",
									"        pm.expect.fail(\"No models found to delete\");\r",
									"    }\r",
									"});\r",
									"\r",
									"// Test that is designed to fail\r",
									"pm.test(\"Response should contain 'nonexistent-value'\", function () {\r",
									"    // Parse the JSON response\r",
									"    var jsonData = pm.response.json();\r",
									"    \r",
									"    // Flatten the response array into a single string\r",
									"    var responseString = JSON.stringify(jsonData);\r",
